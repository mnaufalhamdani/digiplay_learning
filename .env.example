# Database MySQL 8 (atau MariaDB yang setara)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=digiplay_learning

# ID server untuk IdGenerator (2 digit). Wajib beda untuk tiap server/instance aplikasi
# yang menulis ke database yang sama agar ID tidak bentrok.
SERVER_ID=01
# ID server khusus skrip (db:seed, admin:buat, siswa:uji); dibedakan dari aplikasi. Default 99.
SCRIPT_SERVER_ID=99

# Rahasia penanda tangan cookie sesi. WAJIB, minimal 32 karakter; aplikasi tidak mau start bila kosong.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Hostname area (TANPA skema dan port). Saat produksi diganti domain asli,
# misal HOST_SISWA=namadomain.com dan HOST_BACKOFFICE=backoffice.namadomain.com
HOST_SISWA=siswa.localhost
HOST_BACKOFFICE=backoffice.localhost

# Alamat lengkap situs siswa (dengan skema, dan port bila perlu) yang dicetak di kartu kode siswa.
# Saat produksi diganti, misal URL_SISWA=https://namadomain.com
URL_SISWA=http://siswa.localhost:3000

# Jumlah reverse proxy tepercaya di depan aplikasi (minimal 1). IP klien untuk pembatas percobaan login
# diambil dari entri x-forwarded-for ke-N dihitung dari KANAN. Contoh: 1 = hanya nginx; 2 = Cloudflare lalu nginx.
JUMLAH_PROXY_TEPERCAYA=1

# Folder simpan logo dan berkas unggahan (relatif dari root project)
UPLOAD_DIR=uploads
